#!/bin/bash
# Mock TagUI script for testing
echo "TagUI Mock Runner"
echo "Running script: $1"
echo "Arguments: $@"

# Parse arguments
script_file=$1
shift
args=$@

echo "Running in" $(pwd)

# Check if script file exists
if [ ! -f "$script_file" ]; then
    echo "Error: Script file not found: $script_file"
    exit 1
fi

# Output script content
echo "Script content:"
cat "$script_file"

# Simulate execution
echo "Executing script..."
echo "Step 1: focus on 'Notepad' (simulated)"
echo "Step 2: wait 1 second (simulated)"
echo "Step 3: click at position 100,100 (simulated)"
echo "Step 4: type 'Hello from BettermanAI!' (simulated)"
echo "Step 5: press Enter key (simulated)"
echo "Execution completed"

# Exit with success
exit 0